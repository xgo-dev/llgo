+            SIMD_CASE(SIMD_i32x4_max_u, SIMD_DOUBLE_OP(simde_wasm_u32x4_max));
+            SIMD_CASE(SIMD_i32x4_dot_i16x8_s,
+                      SIMD_DOUBLE_OP(simde_wasm_i32x4_dot_i16x8));
+            SIMD_CASE(SIMD_i32x4_extmul_low_i16x8_s,
+                      SIMD_DOUBLE_OP(simde_wasm_i32x4_extmul_low_i16x8));
+            SIMD_CASE(SIMD_i32x4_extmul_high_i16x8_s,
+                      SIMD_DOUBLE_OP(simde_wasm_i32x4_extmul_high_i16x8));
+            SIMD_CASE(SIMD_i32x4_extmul_low_i16x8_u,
+                      SIMD_DOUBLE_OP(simde_wasm_u32x4_extmul_low_u16x8));
+            SIMD_CASE(SIMD_i32x4_extmul_high_i16x8_u,
+                      SIMD_DOUBLE_OP(simde_wasm_u32x4_extmul_high_u16x8));
+
+            /* i64x2 operations */
+            SIMD_CASE(SIMD_i64x2_abs, SIMD_SINGLE_OP(simde_wasm_i64x2_abs));
+            SIMD_CASE(SIMD_i64x2_neg, SIMD_SINGLE_OP(simde_wasm_i64x2_neg));
+        case SIMD_i64x2_all_true:
+        {
+            V128 v1 = POP_V128();
+
+            bool result =
+                simde_wasm_i64x2_all_true(SIMD_V128_TO_SIMDE_V128(v1));
+
+            PUSH_I32(result);
+            break;
+        }
+        case SIMD_i64x2_bitmask:
+        {
+            V128 v1 = POP_V128();
+
+            uint32_t result =
+                simde_wasm_i64x2_bitmask(SIMD_V128_TO_SIMDE_V128(v1));
+
+            PUSH_I32(result);
+            break;
+        }
+            SIMD_CASE(SIMD_i64x2_extend_low_i32x4_s,
+                      SIMD_SINGLE_OP(simde_wasm_i64x2_extend_low_i32x4));
+            SIMD_CASE(SIMD_i64x2_extend_high_i32x4_s,
+                      SIMD_SINGLE_OP(simde_wasm_i64x2_extend_high_i32x4));
+            SIMD_CASE(SIMD_i64x2_extend_low_i32x4_u,
+                      SIMD_SINGLE_OP(simde_wasm_u64x2_extend_low_u32x4));
+            SIMD_CASE(SIMD_i64x2_extend_high_i32x4_u,
+                      SIMD_SINGLE_OP(simde_wasm_u64x2_extend_high_u32x4));
+            SIMD_CASE(SIMD_i64x2_shl, SIMD_LANE_SHIFT(simde_wasm_i64x2_shl));
+            SIMD_CASE(SIMD_i64x2_shr_s, SIMD_LANE_SHIFT(simde_wasm_i64x2_shr));
+            SIMD_CASE(SIMD_i64x2_shr_u, SIMD_LANE_SHIFT(simde_wasm_u64x2_shr));
+            SIMD_CASE(SIMD_i64x2_add, SIMD_DOUBLE_OP(simde_wasm_i64x2_add));
+            SIMD_CASE(SIMD_i64x2_sub, SIMD_DOUBLE_OP(simde_wasm_i64x2_sub));
+            SIMD_CASE(SIMD_i64x2_mul, SIMD_DOUBLE_OP(simde_wasm_i64x2_mul));
+            SIMD_CASE(SIMD_i64x2_eq, SIMD_DOUBLE_OP(simde_wasm_i64x2_eq));
+            SIMD_CASE(SIMD_i64x2_ne, SIMD_DOUBLE_OP(simde_wasm_i64x2_ne));
+            SIMD_CASE(SIMD_i64x2_lt_s, SIMD_DOUBLE_OP(simde_wasm_i64x2_lt));
+            SIMD_CASE(SIMD_i64x2_gt_s, SIMD_DOUBLE_OP(simde_wasm_i64x2_gt));
+            SIMD_CASE(SIMD_i64x2_le_s, SIMD_DOUBLE_OP(simde_wasm_i64x2_le));
+            SIMD_CASE(SIMD_i64x2_ge_s, SIMD_DOUBLE_OP(simde_wasm_i64x2_ge));
+            SIMD_CASE(SIMD_i64x2_extmul_low_i32x4_s,
+                      SIMD_DOUBLE_OP(simde_wasm_i64x2_extmul_low_i32x4));
+            SIMD_CASE(SIMD_i64x2_extmul_high_i32x4_s,
+                      SIMD_DOUBLE_OP(simde_wasm_i64x2_extmul_high_i32x4));
+            SIMD_CASE(SIMD_i64x2_extmul_low_i32x4_u,
+                      SIMD_DOUBLE_OP(simde_wasm_u64x2_extmul_low_u32x4));
+            SIMD_CASE(SIMD_i64x2_extmul_high_i32x4_u,
+                      SIMD_DOUBLE_OP(simde_wasm_u64x2_extmul_high_u32x4));
+
+            /* f32x4 opertions */
+            SIMD_CASE(SIMD_f32x4_abs, SIMD_SINGLE_OP(simde_wasm_f32x4_abs));
+            SIMD_CASE(SIMD_f32x4_neg, SIMD_SINGLE_OP(simde_wasm_f32x4_neg));
+            SIMD_CASE(SIMD_f32x4_sqrt, SIMD_SINGLE_OP(simde_wasm_f32x4_sqrt));
+            SIMD_CASE(SIMD_f32x4_add, SIMD_DOUBLE_OP(simde_wasm_f32x4_add));
+            SIMD_CASE(SIMD_f32x4_sub, SIMD_DOUBLE_OP(simde_wasm_f32x4_sub));
+            SIMD_CASE(SIMD_f32x4_mul, SIMD_DOUBLE_OP(simde_wasm_f32x4_mul));
+            SIMD_CASE(SIMD_f32x4_div, SIMD_DOUBLE_OP(simde_wasm_f32x4_div));
+            SIMD_CASE(SIMD_f32x4_min, SIMD_DOUBLE_OP(simde_wasm_f32x4_min));
+            SIMD_CASE(SIMD_f32x4_max, SIMD_DOUBLE_OP(simde_wasm_f32x4_max));
+            SIMD_CASE(SIMD_f32x4_pmin, SIMD_DOUBLE_OP(simde_wasm_f32x4_pmin));
+            SIMD_CASE(SIMD_f32x4_pmax, SIMD_DOUBLE_OP(simde_wasm_f32x4_pmax));
+
+            /* f64x2 operations */
+            SIMD_CASE(SIMD_f64x2_abs, SIMD_SINGLE_OP(simde_wasm_f64x2_abs));
+            SIMD_CASE(SIMD_f64x2_neg, SIMD_SINGLE_OP(simde_wasm_f64x2_neg));
+            SIMD_CASE(SIMD_f64x2_sqrt, SIMD_SINGLE_OP(simde_wasm_f64x2_sqrt));
+            SIMD_CASE(SIMD_f64x2_add, SIMD_DOUBLE_OP(simde_wasm_f64x2_add));
+            SIMD_CASE(SIMD_f64x2_sub, SIMD_DOUBLE_OP(simde_wasm_f64x2_sub));
+            SIMD_CASE(SIMD_f64x2_mul, SIMD_DOUBLE_OP(simde_wasm_f64x2_mul));
+            SIMD_CASE(SIMD_f64x2_div, SIMD_DOUBLE_OP(simde_wasm_f64x2_div));
+            SIMD_CASE(SIMD_f64x2_min, SIMD_DOUBLE_OP(simde_wasm_f64x2_min));
+            SIMD_CASE(SIMD_f64x2_max, SIMD_DOUBLE_OP(simde_wasm_f64x2_max));
+            SIMD_CASE(SIMD_f64x2_pmin, SIMD_DOUBLE_OP(simde_wasm_f64x2_pmin));
+            SIMD_CASE(SIMD_f64x2_pmax, SIMD_DOUBLE_OP(simde_wasm_f64x2_pmax));
+
+            /* Conversion operations */
+            SIMD_CASE(SIMD_i32x4_trunc_sat_f32x4_s,
+                      SIMD_SINGLE_OP(simde_wasm_i32x4_trunc_sat_f32x4));
+            SIMD_CASE(SIMD_i32x4_trunc_sat_f32x4_u,
+                      SIMD_SINGLE_OP(simde_wasm_u32x4_trunc_sat_f32x4));
+            SIMD_CASE(SIMD_f32x4_convert_i32x4_s,
+                      SIMD_SINGLE_OP(simde_wasm_f32x4_convert_i32x4));
+            SIMD_CASE(SIMD_f32x4_convert_i32x4_u,
+                      SIMD_SINGLE_OP(simde_wasm_f32x4_convert_u32x4));
+            SIMD_CASE(SIMD_i32x4_trunc_sat_f64x2_s_zero,
+                      SIMD_SINGLE_OP(simde_wasm_i32x4_trunc_sat_f64x2_zero));
+            SIMD_CASE(SIMD_i32x4_trunc_sat_f64x2_u_zero,
+                      SIMD_SINGLE_OP(simde_wasm_u32x4_trunc_sat_f64x2_zero));
+            SIMD_CASE(SIMD_f64x2_convert_low_i32x4_s,
+                      SIMD_SINGLE_OP(simde_wasm_f64x2_convert_low_i32x4));
+            SIMD_CASE(SIMD_f64x2_convert_low_i32x4_u,
+                      SIMD_SINGLE_OP(simde_wasm_f64x2_convert_low_u32x4));
+
+        default:
+            wasm_set_exception(module, "unsupported SIMD opcode");
+            goto got_exception;
+    }
+    HANDLE_OP_END();
+}
