diff --git a/core/iwasm/interpreter/wasm_interp_classic_simd.h b/core/iwasm/interpreter/wasm_interp_classic_simd.h
new file mode 100644
index 0000000..7b633a7
--- /dev/null
+++ b/core/iwasm/interpreter/wasm_interp_classic_simd.h
@@ -0,0 +1,774 @@
+/*
+ * Copyright (C) 2019 Intel Corporation.  All rights reserved.
+ * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+ *
+ * SIMD opcode semantics from wasm_interp_fast.c, using the classic
+ * interpreter's value stack and original Wasm immediates.
+ */
+#define SIMD_CASE(op, action) \
+    case op:                  \
+    {                         \
+        action;               \
+        break;                \
+    }
+
+HANDLE_OP(WASM_OP_SIMD_PREFIX)
+{
+    uint32 simd_opcode;
+    read_leb_uint32(frame_ip, frame_ip_end, simd_opcode);
+
+    switch (simd_opcode) {
+        /* Memory */
+        case SIMD_v128_load:
+        {
+            uint32 flags;
+            mem_offset_t offset, addr;
+            read_leb_memarg(frame_ip, frame_ip_end, flags);
+            read_leb_mem_offset(frame_ip, frame_ip_end, offset);
+            addr = POP_MEM_OFFSET();
+            CHECK_MEMORY_OVERFLOW(16);
+            PUSH_V128(LOAD_V128(maddr));
+            break;
+        }
+#define SIMD_LOAD_OP(simde_func)                             \
+    do {                                                     \
+        uint32 flags;                                        \
+        mem_offset_t offset, addr;                           \
+        read_leb_memarg(frame_ip, frame_ip_end, flags);      \
+        read_leb_mem_offset(frame_ip, frame_ip_end, offset); \
+        addr = POP_MEM_OFFSET();                             \
+        CHECK_MEMORY_OVERFLOW(8);                            \
+                                                             \
+        simde_v128_t simde_result = simde_func(maddr);       \
+                                                             \
+        V128 result;                                         \
+        SIMDE_V128_TO_SIMD_V128(simde_result, result);       \
+        PUSH_V128(result);                                   \
+                                                             \
+    } while (0)
+            SIMD_CASE(SIMD_v128_load8x8_s,
+                      SIMD_LOAD_OP(simde_wasm_i16x8_load8x8));
+            SIMD_CASE(SIMD_v128_load8x8_u,
+                      SIMD_LOAD_OP(simde_wasm_u16x8_load8x8));
+            SIMD_CASE(SIMD_v128_load16x4_s,
+                      SIMD_LOAD_OP(simde_wasm_i32x4_load16x4));
+            SIMD_CASE(SIMD_v128_load16x4_u,
+                      SIMD_LOAD_OP(simde_wasm_u32x4_load16x4));
+            SIMD_CASE(SIMD_v128_load32x2_s,
+                      SIMD_LOAD_OP(simde_wasm_i64x2_load32x2));
+            SIMD_CASE(SIMD_v128_load32x2_u,
+                      SIMD_LOAD_OP(simde_wasm_u64x2_load32x2));
+#define SIMD_LOAD_SPLAT_OP(simde_func, width)                \
+    do {                                                     \
+        uint32 flags;                                        \
+        mem_offset_t offset, addr;                           \
+        read_leb_memarg(frame_ip, frame_ip_end, flags);      \
+        read_leb_mem_offset(frame_ip, frame_ip_end, offset); \
+        addr = POP_MEM_OFFSET();                             \
+        CHECK_MEMORY_OVERFLOW(width / 8);                    \
+                                                             \
+        simde_v128_t simde_result = simde_func(maddr);       \
+                                                             \
+        V128 result;                                         \
+        SIMDE_V128_TO_SIMD_V128(simde_result, result);       \
+                                                             \
+        PUSH_V128(result);                                   \
+    } while (0)
+
+            SIMD_CASE(SIMD_v128_load8_splat,
+                      SIMD_LOAD_SPLAT_OP(simde_wasm_v128_load8_splat, 8));
+            SIMD_CASE(SIMD_v128_load16_splat,
+                      SIMD_LOAD_SPLAT_OP(simde_wasm_v128_load16_splat, 16));
+            SIMD_CASE(SIMD_v128_load32_splat,
+                      SIMD_LOAD_SPLAT_OP(simde_wasm_v128_load32_splat, 32));
+            SIMD_CASE(SIMD_v128_load64_splat,
+                      SIMD_LOAD_SPLAT_OP(simde_wasm_v128_load64_splat, 64));
+        case SIMD_v128_store:
+        {
+            uint32 flags;
+            mem_offset_t offset, addr;
+            read_leb_memarg(frame_ip, frame_ip_end, flags);
+            read_leb_mem_offset(frame_ip, frame_ip_end, offset);
+            V128 data = POP_V128();
+            addr = POP_MEM_OFFSET();
+
+            CHECK_MEMORY_OVERFLOW(16);
+            STORE_V128(maddr, data);
+            break;
+        }
+
+        /* Basic */
+        case SIMD_v128_const:
+        {
+            uint8 *orig_ip = frame_ip;
+
+            frame_ip += sizeof(V128);
+
+            PUSH_V128(LOAD_V128(orig_ip));
+            break;
+        }
+        /* TODO: Add a faster SIMD implementation */
+        case SIMD_v8x16_shuffle:
+        {
+            V128 indices;
+            bh_memcpy_s(&indices, sizeof(V128), frame_ip, sizeof(V128));
+            frame_ip += sizeof(V128);
+
+            V128 v2 = POP_V128();
+            V128 v1 = POP_V128();
+
+            V128 result;
+            for (int i = 0; i < 16; i++) {
+                uint8_t index = indices.i8x16[i];
+                if (index < 16) {
+                    result.i8x16[i] = v1.i8x16[index];
+                }
+                else {
+                    result.i8x16[i] = v2.i8x16[index - 16];
+                }
+            }
+
+            PUSH_V128(result);
+            break;
+        }
+        case SIMD_v8x16_swizzle:
+        {
+            V128 v2 = POP_V128();
+            V128 v1 = POP_V128();
+            simde_v128_t simde_result = simde_wasm_i8x16_swizzle(
+                SIMD_V128_TO_SIMDE_V128(v1), SIMD_V128_TO_SIMDE_V128(v2));
+
+            V128 result;
+            SIMDE_V128_TO_SIMD_V128(simde_result, result);
+
+            PUSH_V128(result);
+            break;
+        }
+
+        /* Splat */
+#define SIMD_SPLAT_OP(simde_func, pop_func, val_type)  \
+    do {                                               \
+        val_type v = pop_func();                       \
+                                                       \
+        simde_v128_t simde_result = simde_func(v);     \
+                                                       \
+        V128 result;                                   \
+        SIMDE_V128_TO_SIMD_V128(simde_result, result); \
+                                                       \
+        PUSH_V128(result);                             \
+    } while (0)
+
+#define SIMD_SPLAT_OP_I32(simde_func) SIMD_SPLAT_OP(simde_func, POP_I32, uint32)
+#define SIMD_SPLAT_OP_I64(simde_func) SIMD_SPLAT_OP(simde_func, POP_I64, uint64)
+#define SIMD_SPLAT_OP_F32(simde_func) \
+    SIMD_SPLAT_OP(simde_func, POP_F32, float32)
+#define SIMD_SPLAT_OP_F64(simde_func) \
+    SIMD_SPLAT_OP(simde_func, POP_F64, float64)
+
+        case SIMD_i8x16_splat:
+        {
+            val = POP_I32();
+
+            simde_v128_t simde_result = simde_wasm_i8x16_splat(val);
+
+            V128 result;
+            SIMDE_V128_TO_SIMD_V128(simde_result, result);
+
+            PUSH_V128(result);
+            break;
+        }
+            SIMD_CASE(SIMD_i16x8_splat,
+                      SIMD_SPLAT_OP_I32(simde_wasm_i16x8_splat));
+            SIMD_CASE(SIMD_i32x4_splat,
+                      SIMD_SPLAT_OP_I32(simde_wasm_i32x4_splat));
+            SIMD_CASE(SIMD_i64x2_splat,
+                      SIMD_SPLAT_OP_I64(simde_wasm_i64x2_splat));
+            SIMD_CASE(SIMD_f32x4_splat,
+                      SIMD_SPLAT_OP_F32(simde_wasm_f32x4_splat));
+            SIMD_CASE(SIMD_f64x2_splat,
+                      SIMD_SPLAT_OP_F64(simde_wasm_f64x2_splat));
+#define SIMD_LANE_HANDLE_UNALIGNED_ACCESS()
+
+#define SIMD_EXTRACT_LANE_OP(register, return_type, push_elem) \
+    do {                                                       \
+        uint8 lane = *frame_ip++;                              \
+        SIMD_LANE_HANDLE_UNALIGNED_ACCESS();                   \
+        V128 v = POP_V128();                                   \
+        push_elem((return_type)(v.register[lane]));            \
+    } while (0)
+#define SIMD_REPLACE_LANE_OP(register, return_type, pop_elem) \
+    do {                                                      \
+        uint8 lane = *frame_ip++;                             \
+        SIMD_LANE_HANDLE_UNALIGNED_ACCESS();                  \
+        return_type replacement = pop_elem();                 \
+        V128 v = POP_V128();                                  \
+        v.register[lane] = replacement;                       \
+        PUSH_V128(v);                                         \
+    } while (0)
+            SIMD_CASE(SIMD_i8x16_extract_lane_s,
+                      SIMD_EXTRACT_LANE_OP(i8x16, int8, PUSH_I32));
+            SIMD_CASE(SIMD_i8x16_extract_lane_u,
+                      SIMD_EXTRACT_LANE_OP(i8x16, uint8, PUSH_I32));
+            SIMD_CASE(SIMD_i8x16_replace_lane,
+                      SIMD_REPLACE_LANE_OP(i8x16, int8, POP_I32));
+            SIMD_CASE(SIMD_i16x8_extract_lane_s,
+                      SIMD_EXTRACT_LANE_OP(i16x8, int16, PUSH_I32));
+            SIMD_CASE(SIMD_i16x8_extract_lane_u,
+                      SIMD_EXTRACT_LANE_OP(i16x8, uint16, PUSH_I32));
+            SIMD_CASE(SIMD_i16x8_replace_lane,
+                      SIMD_REPLACE_LANE_OP(i16x8, int16, POP_I32));
+            SIMD_CASE(SIMD_i32x4_extract_lane,
+                      SIMD_EXTRACT_LANE_OP(i32x4, int32, PUSH_I32));
+            SIMD_CASE(SIMD_i32x4_replace_lane,
+                      SIMD_REPLACE_LANE_OP(i32x4, int32, POP_I32));
+            SIMD_CASE(SIMD_i64x2_extract_lane,
+                      SIMD_EXTRACT_LANE_OP(i64x2, int64, PUSH_I64));
+            SIMD_CASE(SIMD_i64x2_replace_lane,
+                      SIMD_REPLACE_LANE_OP(i64x2, int64, POP_I64));
+            SIMD_CASE(SIMD_f32x4_extract_lane,
+                      SIMD_EXTRACT_LANE_OP(f32x4, float32, PUSH_F32));
+            SIMD_CASE(SIMD_f32x4_replace_lane,
+                      SIMD_REPLACE_LANE_OP(f32x4, float32, POP_F32));
+            SIMD_CASE(SIMD_f64x2_extract_lane,
+                      SIMD_EXTRACT_LANE_OP(f64x2, float64, PUSH_F64));
+            SIMD_CASE(SIMD_f64x2_replace_lane,
+                      SIMD_REPLACE_LANE_OP(f64x2, float64, POP_F64));
+
+#define SIMD_DOUBLE_OP(simde_func)                                           \
+    do {                                                                     \
+        V128 v2 = POP_V128();                                                \
+        V128 v1 = POP_V128();                                                \
+                                                                             \
+        simde_v128_t simde_result = simde_func(SIMD_V128_TO_SIMDE_V128(v1),  \
+                                               SIMD_V128_TO_SIMDE_V128(v2)); \
+                                                                             \
+        V128 result;                                                         \
+        SIMDE_V128_TO_SIMD_V128(simde_result, result);                       \
+                                                                             \
+        PUSH_V128(result);                                                   \
+    } while (0)
+
+        /* i8x16 comparison operations */
+        case SIMD_i8x16_eq:
+        {
+            V128 v2 = POP_V128();
+            V128 v1 = POP_V128();
+
+            simde_v128_t simde_result = simde_wasm_i8x16_eq(
+                SIMD_V128_TO_SIMDE_V128(v1), SIMD_V128_TO_SIMDE_V128(v2));
+
+            V128 result;
+            SIMDE_V128_TO_SIMD_V128(simde_result, result);
+
+            PUSH_V128(result);
+            break;
+        }
+            SIMD_CASE(SIMD_i8x16_ne, SIMD_DOUBLE_OP(simde_wasm_i8x16_ne));
+            SIMD_CASE(SIMD_i8x16_lt_s, SIMD_DOUBLE_OP(simde_wasm_i8x16_lt));
+            SIMD_CASE(SIMD_i8x16_lt_u, SIMD_DOUBLE_OP(simde_wasm_u8x16_lt));
+            SIMD_CASE(SIMD_i8x16_gt_s, SIMD_DOUBLE_OP(simde_wasm_i8x16_gt));
+            SIMD_CASE(SIMD_i8x16_gt_u, SIMD_DOUBLE_OP(simde_wasm_u8x16_gt));
+            SIMD_CASE(SIMD_i8x16_le_s, SIMD_DOUBLE_OP(simde_wasm_i8x16_le));
+            SIMD_CASE(SIMD_i8x16_le_u, SIMD_DOUBLE_OP(simde_wasm_u8x16_le));
+            SIMD_CASE(SIMD_i8x16_ge_s, SIMD_DOUBLE_OP(simde_wasm_i8x16_ge));
+            SIMD_CASE(SIMD_i8x16_ge_u, SIMD_DOUBLE_OP(simde_wasm_u8x16_ge));
+
+            /* i16x8 comparison operations */
+            SIMD_CASE(SIMD_i16x8_eq, SIMD_DOUBLE_OP(simde_wasm_i16x8_eq));
+            SIMD_CASE(SIMD_i16x8_ne, SIMD_DOUBLE_OP(simde_wasm_i16x8_ne));
+            SIMD_CASE(SIMD_i16x8_lt_s, SIMD_DOUBLE_OP(simde_wasm_i16x8_lt));
+            SIMD_CASE(SIMD_i16x8_lt_u, SIMD_DOUBLE_OP(simde_wasm_u16x8_lt));
