#!/usr/bin/env bash
set -euo pipefail

# Conda compiler wrappers and their activation scripts expect their own prefix.
export CONDA_PREFIX=${LLGO_CLANG_PREFIX:?run inside the development environment}
for script in "$CONDA_PREFIX"/etc/conda/activate.d/*.sh; do
  # shellcheck disable=SC1090
  [[ ! -f "$script" ]] || source "$script"
done
target="$(uname -m)-conda-linux-gnu"
exec "$CONDA_PREFIX/bin/$target-clang" "$@"
