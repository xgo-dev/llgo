{
	"llvm-target": "wasm32-unknown-wasip1",
	"cpu": "generic",
	"build-tags": ["llgo.wasm.wasi"],
	"goos": "wasip1",
	"goarch": "wasm",
	"wasm-profile": "w32",
	"wasm-provider": "wasi",
	"emulator": "wasmer run --cranelift --disable-cache --enable-exceptions --enable-simd --stack-size=1048576 --volume=. --volume=/tmp \"{}\""
}
