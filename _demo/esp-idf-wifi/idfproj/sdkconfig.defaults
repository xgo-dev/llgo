# llgo runs its scheduler and package init on the FreeRTOS main task; give it
# headroom (the fiber stacks themselves come from the llgo GC heap).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# llgo's esp32s31 clock gate assumes a 240 MHz CPU (baremetalCpuMHz in
# runtime/internal/runtime/z_clock_freq_esp32s31.go). Keep the IDF frequency
# matched so cycle-domain deadlines (time.Sleep, timers) read true seconds.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The llgo fiber scheduler swaps the task's SP out of the FreeRTOS task stack
# onto GC-heap-allocated fiber stacks on every scheduling point. That is
# exactly what the stack guards look for: the ASSIST_DEBUG hardware guard
# panics as soon as SP leaves the task's registered bounds, and the canary
# checker runs on every context switch. Disable both - llgo guards its own
# stacks with a canary + SP bound at every cooperative swap
# (_wrap/context_riscv32.c), so fiber overflows stay detected inside the Go
# runtime itself.
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=n
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y

# Multi-core layout (TinyGo-style hardware isolation): the llgo scheduler and
# all Go code run on CPU1; the radio stack (WiFi tasks, lwip tcpip, BT, and
# esp_timer, which default to CPU0) stays on CPU0. Scan/association bursts,
# protocol timers and the radio interrupts that follow their tasks never
# preempt the Go control loop. The scheduler itself is unchanged - still one
# cooperative task; the isolation is FreeRTOS task affinity, not a second
# scheduler. (A Go-visible LockCore API and true two-core scheduling are
# separate, larger projects.)
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# External PSRAM: the S31 die defaults to octal mode at 200 MHz; measured
# 16 MiB present with ~157 MB/s sequential read. malloc may serve from it, but
# allocations that must be DMA-visible or touched by IDF internals stay
# internal, hence the 32 KiB reserve below. IGNORE_NOTFOUND keeps boards
# without PSRAM chips bootable; llgo then keeps the Go heap in its static
# window.
CONFIG_SPIRAM=y
# Also boot on boards that have no PSRAM fitted: IDF then reports zero
# SPIRAM and llgo keeps the Go heap in its static window (see README).
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# The peripheral drivers (I2C/I2S) push the app binary past 1 MiB; widen the
# factory app partition to the rest of the 4 MB flash (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ConnectionState.PeerCerts (pkg/esp/tls): IDF's mbedtls Kconfig defaults to
# dropping the peer certificate right after verification (~4 kB heap saved
# per session), which leaves mbedtls_ssl_get_peer_cert returning NULL. The
# tls probe's acceptance prints nothing about the certificate if it is not
# kept - enable the option so the exported DER is real. Projects that do
# not need pinning/auditing can leave it off; tls.State then reports the
# negotiated version/cipher with an empty PeerCerts (documented in
# pkg/esp/README.md).
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=y
