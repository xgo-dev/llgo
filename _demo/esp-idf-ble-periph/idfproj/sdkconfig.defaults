# llgo runs its scheduler and package init on the FreeRTOS main task; give it
# headroom (the fiber stacks themselves come from the llgo GC heap).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# llgo's esp32s31 clock gate assumes a 240 MHz CPU (baremetalCpuMHz in
# runtime/internal/runtime/z_clock_freq_esp32s31.go). Keep the IDF frequency
# matched so cycle-domain deadlines (time.Sleep, timers) read true seconds.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The llgo fiber scheduler swaps the task's SP out of the FreeRTOS task stack
# onto GC-heap-allocated fiber stacks on every scheduling point. That is
# exactly what the stack guards look for: the ASSIST_DEBUG hardware guard
# panics as soon as SP leaves the task's registered bounds, and the canary
# checker runs on every context switch. Disable both - llgo guards its own
# stacks with a canary + SP bound at every cooperative swap
# (_wrap/context_riscv32.c), so fiber overflows stay detected inside the Go
# runtime itself.
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=n
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y

# External PSRAM: the S31 die defaults to octal mode at 200 MHz. malloc may
# serve from it, but allocations that must be DMA-visible or touched by IDF
# internals stay internal, hence the 32 KiB reserve below.
CONFIG_SPIRAM=y
# Also boot on boards with no PSRAM fitted: IDF then reports zero SPIRAM and
# llgo keeps the Go heap in its static window.
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# App partition: 3.9375 MiB of the 4 MB flash (see partitions.csv).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- BLE (BLE-only firmware: no WiFi stack is initialized in this demo) ----
# Bluedroid, not NimBLE: this demo exercises the peripheral half of the
# llgo_ble_* ABI, which the Bluedroid backend implements (advertising and the
# GATT server); the central demo links the NimBLE backend for the client side.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLE_ENABLED=y

# The legacy GAP/GATT API set: the glue's advertising (raw payload + start)
# and scan paths speak the 4.2-feature calls, the peripheral role's surface.
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# Both BLE roles on the host: the GATT server (this demo's subject) and the
# client half the same package keeps working.
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y

# SMP: SetSecurityParams installs the pairing posture (bond + MITM posture);
# without the component the parameter calls refuse.
CONFIG_BT_BLE_SMP_ENABLE=y

# Room for the glue's per-service attribute budgets (a service declares its
# own handle count; the stack caps it at this pool).
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=64

# The Bluedroid host's pools and the BTU/HCI task stacks are the biggest
# internal-RAM consumers; serve them from PSRAM first (falls back to internal
# per-allocation), keeping internal SRAM for the llgo GC window and the
# controller. The task-stack switch needs FreeRTOS tasks creatable in
# external memory.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_BT_BLUEDROID_TASK_STACK_IN_EXT_MEM=y
CONFIG_BT_BLUEDROID_BTU_TASK_STACK_IN_EXT_MEM=y
CONFIG_BT_BLUEDROID_HCI_TASK_STACK_IN_EXT_MEM=y
