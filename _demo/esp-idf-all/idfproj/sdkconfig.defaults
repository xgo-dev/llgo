# llgo runs its scheduler and package init on the FreeRTOS main task; give it
# headroom (the fiber stacks themselves come from the llgo GC heap).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# llgo's esp32s31 clock gate assumes a 240 MHz CPU (baremetalCpuMHz in
# runtime/internal/runtime/z_clock_freq_esp32s31.go). Keep the IDF frequency
# matched so cycle-domain deadlines (time.Sleep, timers) read true seconds.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The llgo fiber scheduler swaps the task's SP out of the FreeRTOS task stack
# onto GC-heap-allocated fiber stacks on every scheduling point. That is
# exactly what the stack guards look for: the ASSIST_DEBUG hardware guard
# panics as soon as SP leaves the task's registered bounds, and the canary
# checker runs on every context switch. Disable both - llgo guards its own
# stacks with a canary + SP bound at every cooperative swap
# (_wrap/context_riscv32.c), so fiber overflows stay detected inside the Go
# runtime itself.
CONFIG_ESP_SYSTEM_HW_STACK_GUARD=n
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_NONE=y

# Radio work layout, the combination the station demo verified on real
# ESP32-S31 hardware: all Go code on CPU1 (main task pinned there), the
# radio stack (WiFi tasks, lwip tcpip) on CPU0. The AP demo's shipped
# defaults pin the WiFi stack to CPU1 instead - that layout hangs
# esp_wifi_init on real hardware (2/2 reproduced), so every WiFi+BT demo
# carries this station layout.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# The soft AP's DHCP server: the "phone gets a lease" step of the AP
# verification rests on it.
CONFIG_LWIP_DHCPS=y

# External PSRAM: the S31 die defaults to octal mode at 200 MHz. malloc may
# serve from it, but allocations that must be DMA-visible or touched by IDF
# internals stay internal, hence the 32 KiB reserve below. IGNORE_NOTFOUND
# keeps boards without a PSRAM chip bootable; llgo then keeps the Go heap in
# its static window.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MEMTEST=y
# Only small allocations prefer internal SRAM: the all-on firmware's
# internal budget is claimed by the BT host and the WiFi driver, so
# everything bigger that can live in PSRAM should.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# App partition: 3.9375 MiB of the 4 MB flash (see partitions.csv). The
# dual-mode Bluedroid host with classic profiles plus the WiFi driver is the
# biggest app this pipeline builds.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Bluetooth: one dual-mode Bluedroid host serving everything ----
#
# The firmware runs the A2DP sink (classic profile) and the BLE central
# (GATT client) side by side, so the controller runs in BTDM (BR/EDR + LE,
# the only S31 mode with BR/EDR) and both host halves are enabled. pkg/esp/bt
# and pkg/esp/ble join the running stack through the same host: bt.Init
# brings it up, ble.Init detects it and registers its own callbacks only
# (the project's ble_glue.c patch - see the file header). Keep SPP enabled:
# the pkg/esp/bt glue template requires it at compile time even though this
# firmware never listens (CONFIG_BT_SPP_ENABLED guard in bt_glue.c).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_BLE_ENABLED=y

# Internal-RAM budget: this firmware runs the full dual-mode host (classic
# + BLE GATT client) AND the WiFi driver on one chip, and both stacks size
# most of their pools from internal SRAM. Real-hardware measurement: with
# everything enabled by default, a2dp-init leaves ~32 KB of internal free
# and wifi.Setup fails with ESP_ERR_NO_MEM. The firmware uses none of the
# server-side or aggregation features, so drop their pools: GATTS (this is
# a GATT client only), extended/periodic advertising (it scans and
# initiates only) and the WiFi AMPDU BA sessions (a one-client soft AP
# serving a probe page needs no aggregation; the RX BA window alone is a
# multi-KB internal block), and trim the static RX buffers.
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_BLE_50_EXTEND_ADV_EN=n
CONFIG_BT_BLE_50_PERIODIC_ADV_EN=n
CONFIG_BT_LE_ENABLE_PERIODIC_ADV=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# The Bluedroid host's pools serve from PSRAM first (falls back to internal
# per-allocation). NOTE: the task-stack-in-ext-mem options are deliberately
# OFF, and with them CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM: with that
# switch on, every flash cache-disabled section asserts that the running
# task's stack is sane (spi_flash cache_utils.c), and the llgo fiber
# scheduler runs its goroutines on GC-heap fiber stacks that are by design
# outside the FreeRTOS task's registered stack - a fiber stack that ever
# lands in a PSRAM heap segment turns every NVS write into an abort (and a
# PSRAM stack is genuinely unreadable while the flash cache is off). Keeping
# the switch off keeps every task stack internal and the assert silent.
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
# Explicitly off (its Kconfig default is y under SPIRAM): with it on, every
# flash cache-disabled section asserts that the running task's stack is
# sane (spi_flash cache_utils.c), and the llgo fiber scheduler runs its
# goroutines on GC-heap fiber stacks that are by design outside the
# FreeRTOS task's registered stack - a fiber stack that ever lands in a
# PSRAM heap segment turns every NVS write into an abort (and a PSRAM stack
# is genuinely unreadable while the flash cache is off). With it off every
# task stack is internal and the assert is compiled out.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=n
# CONFIG_BT_BLUEDROID_TASK_STACK_IN_EXT_MEM is deliberately not set
# CONFIG_BT_BLUEDROID_BTU_TASK_STACK_IN_EXT_MEM is deliberately not set
# CONFIG_BT_BLUEDROID_HCI_TASK_STACK_IN_EXT_MEM is deliberately not set

# A HID keyboard exposes more notify characteristics than the default
# registration table holds; the surplus registrations fail with
# "Max Notification Reached" and those keys would never be delivered.
CONFIG_BT_GATTC_NOTIF_REG_MAX=16

# Cache the peer attribute table per connection (Bluedroid): a reconnect
# skips service discovery (~1.3 s on this link) when the table is intact.
CONFIG_BT_GATTC_CACHE=y
