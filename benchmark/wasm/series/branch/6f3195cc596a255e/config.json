{
  "version": 1,
  "id": "llgo-wasm",
  "title": "LLGo WebAssembly build benchmarks",
  "sitePath": "benchmark/wasm",
  "include": [
    "^BenchmarkWasm(Size|Build)/"
  ],
  "exclude": [],
  "maxBenchmarks": 500,
  "groups": {
    "wasm-size": {
      "title": "Wasm Size",
      "match": [
        "^WasmSize/"
      ],
      "chart": "combined"
    },
    "wasm-build": {
      "title": "Wasm Build",
      "match": [
        "^WasmBuild/"
      ],
      "chart": "combined"
    }
  },
  "views": {
    "wasm-size": {
      "title": "WebAssembly output sizes",
      "select": {
        "groups": [
          "^wasm-size$"
        ],
        "metrics": [
          "^(module-bytes|glue-bytes)$"
        ]
      },
      "table": {
        "rows": [
          "benchmark"
        ],
        "columns": [
          "metric"
        ],
        "collapsed": false,
        "missing": "error",
        "empty": "error",
        "max-rows": 200,
        "dimensions": {
          "benchmark": {
            "title": "Profile and compiler",
            "trim-prefix": "BenchmarkWasmSize/"
          }
        },
        "metrics": {
          "module-bytes": {
            "title": "Wasm module",
            "format": "bytes"
          },
          "glue-bytes": {
            "title": "Generated JS glue",
            "format": "bytes"
          }
        }
      }
    },
    "wasm-build": {
      "title": "LLGo WebAssembly build measurements",
      "select": {
        "groups": [
          "^wasm-build$"
        ],
        "metrics": [
          "^build-ns$"
        ]
      },
      "table": {
        "rows": [
          "benchmark"
        ],
        "columns": [
          "metric"
        ],
        "collapsed": false,
        "missing": "error",
        "empty": "error",
        "max-rows": 200,
        "dimensions": {
          "benchmark": {
            "title": "Profile",
            "trim-prefix": "BenchmarkWasmBuild/"
          }
        },
        "metrics": {
          "build-ns": {
            "title": "Build",
            "format": "duration-ns"
          }
        }
      }
    }
  }
}
